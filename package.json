{
  "name": "netflix-shortcut-override",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "rm -rf dist && vite",
    "changelog": "node scripts/generate-release-notes.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build && node scripts/fix-extension-build.mjs",
    "build:firefox": "npm run build && npm run prepare:firefox",
    "package:chromium": "node scripts/build-chromium-package.mjs",
    "package:firefox": "node scripts/build-firefox-package.mjs",
    "prepare:firefox": "node scripts/prepare-firefox-dist.mjs",
    "lint:firefox": "web-ext lint --source-dir firefox-dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version:check": "node scripts/check-version-consistency.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.1.42",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.13.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.6",
    "web-ext": "10.5.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "hono": "^4.12.30",
    "js-yaml": "^4.3.0",
    "qs": "^6.15.3"
  }
}
